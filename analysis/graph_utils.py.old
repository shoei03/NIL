#!/usr/bin/env python3
"""
グラフ操作ユーティリティ

クローンペアからグラフを構築し、連結成分を検出するためのユーティリティ関数を提供する。
"""

import logging
from typing import Dict, List, Optional, Set

import networkx as nx
import pandas as pd


class GraphUtils:
    """グラフ操作のためのユーティリティクラス"""

    def __init__(self, logger: Optional[logging.Logger] = None):
        """
        初期化

        Args:
            logger: ログ出力用のlogger（Noneの場合は新規作成）
        """
        self.logger = logger or logging.getLogger(__name__)

    def build_graph_from_pairs(
        self, pairs_df: pd.DataFrame, ngram_threshold: int = 50, lcs_threshold: int = 60
    ) -> nx.Graph:
        """
        クローンペアのDataFrameからグラフを構築する

        Args:
            pairs_df: クローンペアのDataFrame
                     columns: ['block_id1', 'block_id2', 'ngram_similarity', 'lcs_similarity']
            ngram_threshold: N-gram類似度の閾値（0-100）
            lcs_threshold: LCS類似度の閾値（0-100）

        Returns:
            構築されたグラフ（NetworkX Graph）
        """
        graph = nx.Graph()
        added_edges = 0
        filtered_edges = 0

        for _, row in pairs_df.iterrows():
            block_id1 = row["block_id1"]
            block_id2 = row["block_id2"]
            ngram_sim = row["ngram_similarity"]
            lcs_sim = row["lcs_similarity"]

            # 類似度の決定
            effective_similarity = self._get_effective_similarity(ngram_sim, lcs_sim)

            # 閾値チェック
            if self._meets_threshold(
                effective_similarity, ngram_sim, lcs_sim, ngram_threshold, lcs_threshold
            ):
                graph.add_edge(
                    block_id1,
                    block_id2,
                    similarity=effective_similarity,
                    ngram_similarity=ngram_sim,
                    lcs_similarity=lcs_sim,
                )
                added_edges += 1
            else:
                filtered_edges += 1

        self.logger.info(
            f"グラフ構築完了: {added_edges}個のエッジを追加, {filtered_edges}個のエッジをフィルタリング"
        )
        self.logger.info(
            f"グラフ統計: {graph.number_of_nodes()}個のノード, {graph.number_of_edges()}個のエッジ"
        )

        return graph

    def find_connected_components(self, graph: nx.Graph) -> List[Set[str]]:
        """
        グラフの連結成分を検出する

        Args:
            graph: NetworkX Graph

        Returns:
            連結成分のリスト（各成分はノードIDのセット）
        """
        components = list(nx.connected_components(graph))

        # サイズ順でソート（大きい順）
        components.sort(key=len, reverse=True)

        self.logger.info(f"連結成分検出完了: {len(components)}個の成分")

        # 成分サイズの統計
        sizes = [len(comp) for comp in components]
        if sizes:
            self.logger.info(
                f"成分サイズ統計: 最大={max(sizes)}, 最小={min(sizes)}, 平均={sum(sizes) / len(sizes):.1f}"
            )

        return components

    def calculate_component_statistics(
        self, graph: nx.Graph, components: List[Set[str]]
    ) -> Dict[str, Dict]:
        """
        連結成分の統計情報を計算する

        Args:
            graph: NetworkX Graph
            components: 連結成分のリスト

        Returns:
            各成分の統計情報を含む辞書
        """
        stats = {}

        for i, component in enumerate(components):
            component_nodes = list(component)

            # 成分内のエッジの類似度を取得
            similarities = []
            ngram_similarities = []
            lcs_similarities = []

            for node1 in component_nodes:
                for node2 in component_nodes:
                    if node1 < node2 and graph.has_edge(node1, node2):
                        edge_data = graph[node1][node2]
                        similarities.append(edge_data.get("similarity", 0))
                        ngram_similarities.append(edge_data.get("ngram_similarity", 0))
                        lcs_similarities.append(edge_data.get("lcs_similarity", 0))

            # 統計計算
            avg_similarity = (
                sum(similarities) / len(similarities) if similarities else 0
            )
            avg_ngram = (
                sum(ngram_similarities) / len(ngram_similarities)
                if ngram_similarities
                else 0
            )
            avg_lcs = (
                sum(lcs_similarities) / len(lcs_similarities) if lcs_similarities else 0
            )

            stats[i] = {
                "size": len(component),
                "avg_similarity": avg_similarity,
                "avg_ngram_similarity": avg_ngram,
                "avg_lcs_similarity": avg_lcs,
                "edge_count": len(similarities),
            }

        return stats

    def _get_effective_similarity(
        self, ngram_sim: float, lcs_sim: Optional[float]
    ) -> float:
        """
        有効な類似度を決定する

        Args:
            ngram_sim: N-gram類似度
            lcs_sim: LCS類似度（Noneの場合は計算されていない）

        Returns:
            有効な類似度値
        """
        if lcs_sim is not None and not pd.isna(lcs_sim) and lcs_sim != "":
            # LCS類似度が利用可能な場合は優先
            return float(lcs_sim)
        else:
            # N-gram類似度のみの場合
            return float(ngram_sim)

    def _meets_threshold(
        self,
        effective_similarity: float,
        ngram_sim: float,
        lcs_sim: Optional[float],
        ngram_threshold: int,
        lcs_threshold: int,
    ) -> bool:
        """
        閾値を満たすかどうかを判定する

        Args:
            effective_similarity: 有効な類似度
            ngram_sim: N-gram類似度
            lcs_sim: LCS類似度
            ngram_threshold: N-gram類似度の閾値
            lcs_threshold: LCS類似度の閾値

        Returns:
            閾値を満たす場合はTrue
        """
        # LCS類似度が利用可能な場合はLCS閾値で判定
        if lcs_sim is not None and not pd.isna(lcs_sim) and lcs_sim != "":
            return effective_similarity >= lcs_threshold
        else:
            # N-gram類似度のみの場合はN-gram閾値で判定
            return effective_similarity >= ngram_threshold

    def get_node_to_component_mapping(
        self, components: List[Set[str]]
    ) -> Dict[str, int]:
        """
        ノードIDから成分IDへのマッピングを作成する

        Args:
            components: 連結成分のリスト

        Returns:
            ノードID -> 成分ID の辞書
        """
        mapping = {}
        for component_id, component in enumerate(components):
            for node_id in component:
                mapping[node_id] = component_id

        return mapping
